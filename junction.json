{
    "name": "text-to-speech",
    "runtime": {
        "port": 8085,
        "install": ["uv", "sync"],
        "command": [
            "uv", "run", "python", "-m", "uvicorn",
            "main:app",
            "--host", "127.0.0.1",
            "--port", "8085"
        ]
    },
    "routing": {
        "prefix": "/texttospeech"
    },
    "health": {
        "path": "/health"
    }
}
